 Idol.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eRound 9\u003c/strong\u003e\u003cbr\u003e\n[Moth Dust] dealt 494 damage to your Anubisath Idol.\u003cbr\u003e\n[Moth Dust] missed your Anubisath Idol.\u003cbr\u003e\n[Sandstorm] dealt 666 damage to enemy Dusty.\u003cbr\u003e\n[Sandstorm] changed the weather to [Sandstorm].\u003cbr\u003e\n[Recovery] healed 69 damage from your Anubisath Idol.\u003c/p\u003e\n\u003chr\u003e\n\u003cp\u003ePatch 9.1 managed to break these pet battles and possibly others in a spectacular way.\u003c/p\u003e","post_number":3,"post_type":1,"posts_count":5,"updated_at":"2026-06-27T10:04:18.915Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":14,"readers_count":13,"score":7.8,"yours":false,"topic_id":1013569,"topic_slug":"pandaria-grand-master-pet-tamer-bug-possibly-others","display_username":"Onomatopoeia","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":3,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2544047,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":"Ownership transferred","can_view_edit_history":false,"wiki":false,"user_custom_fields":{"profile_url":"https://worldofwarcraft.com/en-us/character/us/bloodhoof/alldressed/","guild":"Cow Goes Moo","race":"Troll","class":"Death Knight","player_class_enum":"DEATHKNIGHT","level":"58","classic":"t","blizzard_post_count":"146","achievement_points":"2585"},"post_url":"/t/pandaria-grand-master-pet-tamer-bug-possibly-others/1013569/3","alias_avatar":"https://render.worldofwarcraft.com/us/character/bloodhoof/180/165182644-avatar.jpg?alt=/wow/static/images/2d/avatar/6-1.jpg","alias_username":"Rimeheart","poster_alias":{"alias":{"name":"Rime